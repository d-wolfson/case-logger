{
  "name": "case-logger",
  "version": "1.0.0",
  "description": "Neurosurgery case logging app with AI-powered data extraction",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "doctor": "node scripts/doctor.mjs",
    "validate": "node scripts/validate.mjs",
    "backup": "node scripts/backup-local.mjs",
    "restore": "node scripts/restore-local.mjs",
    "acgme:queue": "node scripts/acgme-worklist.mjs",
    "acgme:next": "node scripts/acgme-worklist.mjs --next",
    "acgme:sample": "node scripts/acgme-worklist.mjs --fixture fixtures/sample-cases.json",
    "acgme:chrome:check": "node scripts/acgme-chrome.mjs check",
    "acgme:chrome:inspect": "node scripts/acgme-chrome.mjs inspect",
    "acgme:chrome:fill-next": "node scripts/acgme-chrome.mjs fill-next",
    "acgme:chrome:run-queue": "node scripts/acgme-chrome.mjs run-queue"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "archiver": "^6.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "multer": "^2.0.0",
    "sql.js": "^1.10.3",
    "unzipper": "^0.10.14",
    "xlsx": "^0.18.5"
  }
}
